@using GoldenWhistle.ViewModels.Data
@model MatchStatsViewModel
@{
    ViewData["Title"] = "Data Visualizer";
    ViewData["Page"] = "data";
}

@* FIX (audit §1, critique): this view previously had NO @model directive
   and never referenced @Model at all — the scoreboard, stat row, and the
   entire "AI Match Summary" paragraph were hardcoded fake HTML ("Brazil 2-1
   Argentina", fixed xG/possession numbers, a fabricated summary mentioning
   Vinicius Jr./Rodrygo/Messi), even though DataController.Index() was
   already building a real MatchStatsViewModel from the database. This
   version renders that real model. If there is no live/recent match, it
   now shows an honest empty state instead of fake numbers. *@

<div class="page-header">
    <div>
        <h1>Data Visualizer</h1>
        <p class="subtitle" id="dataMatchLabel">
            @if (!string.IsNullOrEmpty(Model.HomeTeam))
            {
                @($"{(Model.IsLive ? "Live analytics" : "Latest match")} · {Model.HomeTeam} {Model.HomeScore}–{Model.AwayScore} {Model.AwayTeam}")
            }
            else
            {
                @:No match data available yet
            }
        </p>
    </div>
    <div class="page-actions">
        @if (Model.IsLive)
        {
            <span class="badge badge-live"><span class="dot live"></span>LIVE @Model.Minute'</span>
        }
        <button class="btn btn-outline">Export</button>
    </div>
</div>

<div style="padding: 0 var(--space-6) var(--space-8);">

    @if (string.IsNullOrEmpty(Model.HomeTeam))
    {
        <div class="panel text-center" style="padding:var(--space-8);">
            <p class="text-secondary">No started match found yet. Stats will appear here once a match kicks off.</p>
        </div>
    }
    else
    {
        @* ---- Match scoreboard (real data) ---- *@
        <div class="panel mb-4">
            <div class="data-scoreboard">
                <div class="data-team">
                    <div class="data-team-code">@Model.HomeTeamCode</div>
                    <div class="data-team-name">@Model.HomeTeam</div>
                </div>
                <div class="data-score-center">
                    <div class="data-score-minute">@(Model.IsLive ? $"{Model.Minute}'" : "FT")</div>
                    <div class="data-score-main">
                        <span class="data-score-home">@Model.HomeScore</span>
                        <span class="data-score-sep">–</span>
                        <span class="data-score-away">@Model.AwayScore</span>
                    </div>
                    @if (Model.IsLive)
                    {
                        <span class="badge badge-live">LIVE</span>
                    }
                    else
                    {
                        <span class="badge badge-ft">FT</span>
                    }
                </div>
                <div class="data-team data-team-right">
                    <div class="data-team-code">@Model.AwayTeamCode</div>
                    <div class="data-team-name">@Model.AwayTeam</div>
                </div>
            </div>

            <div class="data-stats-row">
                <div class="data-stat-col">
                    <span class="data-stat-home" style="color:var(--green);">@Model.HomeXg.ToString("0.00")</span>
                    <span class="data-stat-label">XG</span>
                    <span class="data-stat-away">@Model.AwayXg.ToString("0.00")</span>
                </div>
                <div class="data-stat-col">
                    <span class="data-stat-home" style="color:var(--green);">@Model.HomeShots</span>
                    <span class="data-stat-label">SHOTS</span>
                    <span class="data-stat-away">@Model.AwayShots</span>
                </div>
                <div class="data-stat-col">
                    <span class="data-stat-home" style="color:var(--green);">@Model.HomePossession%</span>
                    <span class="data-stat-label">POSSESSION</span>
                    <span class="data-stat-away">@Model.AwayPossession%</span>
                </div>
                <div class="data-stat-col">
                    <span class="data-stat-home" style="color:var(--green);">@Model.HomePasses</span>
                    <span class="data-stat-label">PASSES</span>
                    <span class="data-stat-away">@Model.AwayPasses</span>
                </div>
                <div class="data-stat-col">
                    <span class="data-stat-home" style="color:var(--green);">@Model.HomeDuelsWon</span>
                    <span class="data-stat-label">DUELS WON</span>
                    <span class="data-stat-away">@Model.AwayDuelsWon</span>
                </div>
            </div>
        </div>

        @* ---- xG Timeline + Team Radar (fed by /api/data/stats — already real) ---- *@
        <div class="row g-4 mb-4">
            <div class="col-md-8">
                <div class="panel">
                    <h3 style="font-size:20px;">xG Timeline</h3>
                    <p class="text-secondary" style="font-size:13px;margin-top:4px;margin-bottom:20px;">Cumulative expected goals over 90 minutes</p>
                    <div class="chart-wrap" style="height:220px;">
                        <canvas id="xgTimelineChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel h-100">
                    <h3 style="font-size:20px;">Team Radar</h3>
                    <p class="text-secondary" style="font-size:13px;margin-top:4px;margin-bottom:20px;">Performance comparison</p>
                    <div class="chart-wrap" style="height:220px;">
                        <canvas id="teamRadarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        @* ---- Possession Flow + Summary ---- *@
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="panel">
                    <h3 style="font-size:20px;">Possession Flow</h3>
                    <p class="text-secondary" style="font-size:13px;margin-top:4px;margin-bottom:20px;">By 15-min interval</p>
                    <div class="chart-wrap" style="height:220px;">
                        <canvas id="possessionChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="panel">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="stat-icon" style="background:var(--green-bg);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M13 2L3 14h7l-1 8 11-13h-7z" /></svg>
                        </div>
                        <h3 style="font-size:20px;">Match Summary</h3>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.AiSummary))
                    {
                        <p class="text-secondary" style="font-size:14px;line-height:1.7;">@Model.AiSummary</p>
                        <p class="text-tertiary" style="font-size:12px;margin-top:16px;">Generated by GoldenWhistle AI · Not affiliated with FIFA</p>
                    }
                    else
                    {
                        <p class="text-secondary" style="font-size:14px;line-height:1.7;">
                            No summary available yet for this match.
                        </p>
                    }
                </div>
            </div>
        </div>

        @* ---- Heat Map (fed by real /api/data/stats data, see note below) ---- *@
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 style="font-size:20px;">Heat Map Overlay</h3>
                    <p class="text-secondary" style="font-size:13px;margin-top:4px;">Ball touch concentration</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline heatmap-team-btn active" onclick="setHeatmapTeam(this,'home')">@Model.HomeTeamCode</button>
                    <button class="btn btn-ghost heatmap-team-btn" onclick="setHeatmapTeam(this,'away')">@Model.AwayTeamCode</button>
                </div>
            </div>
            <div class="heatmap-pitch" id="heatmapPitch">
                <canvas id="heatmapCanvas"></canvas>
                <div class="heatmap-legend">
                    <span class="d-flex align-items-center gap-2"><span class="dot" style="background:var(--green);"></span>@Model.HomeTeamCode intensity</span>
                    <span class="d-flex align-items-center gap-2"><span class="dot" style="background:var(--red);"></span>@Model.AwayTeamCode</span>
                </div>
            </div>
        </div>
    }
</div>
