@model GoldenWhistle.ViewModels.BracketViewModel
@{
    ViewData["Title"] = "Bracket Challenge";
    ViewData["Page"] = "bracket";
}

<div class="page-header">
    <div>
        <h1>Bracket Challenge</h1>
        <p class="subtitle">Predict match outcomes and earn points</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-outline" data-action="share-bracket">Share Bracket</button>
        <button class="btn btn-primary" data-action="lock-predictions">Lock Predictions</button>
    </div>
</div>

<div class="content-grid">
    <div class="panel">
        <div class="section-header">
            <div>
                <h3 style="font-size:22px;">Your Bracket</h3>
                <p class="text-secondary" style="font-size:14px;margin-top:4px;">
                    @Model.TotalCorrect of @(Model.Picks.Count) correct
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge badge-success">@Model.TotalCorrect Correct</span>
                <span class="badge badge-upcoming">@Model.TotalPending Pending</span>
            </div>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-md-4">
                <span class="section-title d-block mb-2">QF</span>
                @foreach (var pick in Model.Picks.Where(p => p.Round == "QF"))
                {
                    var homeWin = pick.HomeScore.HasValue && pick.AwayScore.HasValue && pick.HomeScore > pick.AwayScore;
                    var awayWin = pick.HomeScore.HasValue && pick.AwayScore.HasValue && pick.AwayScore > pick.HomeScore;
                    var draw = pick.HomeScore.HasValue && pick.AwayScore.HasValue && pick.HomeScore == pick.AwayScore;
                    <div class="card @(homeWin ? "is-active" : "") mb-2">
                        <div class="d-flex justify-content-between">
                            <span><span class="text-tertiary me-2" style="font-size:11px;">@pick.HomeTeamCode</span><strong>@pick.HomeTeamName</strong></span>
                            <strong style="color: @(homeWin ? "var(--green)" : draw ? "var(--amber)" : "var(--text-primary)")">
                                @(pick.HomeScore?.ToString() ?? "—")
                            </strong>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span><span class="text-tertiary me-2" style="font-size:11px;">@pick.AwayTeamCode</span>@pick.AwayTeamName</span>
                            <strong style="color: @(awayWin ? "var(--green)" : draw ? "var(--amber)" : "var(--text-primary)")">
                                @(pick.AwayScore?.ToString() ?? "—")
                            </strong>
                        </div>
                        @if (!pick.IsLive)
                        {
                            <div class="text-tertiary text-mono" style="font-size:11px;margin-top:6px;">
                                ⏱ @pick.KickoffTime
                            </div>
                        }
                        else
                        {
                            <span class="badge badge-live mt-2"><span class="dot live"></span>LIVE</span>
                        }
                    </div>
                }
            </div>

            <div class="col-md-4">
                <span class="section-title d-block mb-2">SF</span>
                @foreach (var pick in Model.Picks.Where(p => p.Round == "SF"))
                {
                    var homeWin = pick.HomeScore.HasValue && pick.AwayScore.HasValue && pick.HomeScore > pick.AwayScore;
                    var awayWin = pick.HomeScore.HasValue && pick.AwayScore.HasValue && pick.AwayScore > pick.HomeScore;
                    <div class="card @(homeWin ? "is-active" : "") mb-2">
                        <div class="d-flex justify-content-between">
                            <span><span class="text-tertiary me-2" style="font-size:11px;">@pick.HomeTeamCode</span><strong>@pick.HomeTeamName</strong></span>
                            <strong style="color: @(homeWin ? "var(--green)" : "var(--text-primary)")">
                                @(pick.HomeScore?.ToString() ?? "—")
                            </strong>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span><span class="text-tertiary me-2" style="font-size:11px;">@pick.AwayTeamCode</span>@pick.AwayTeamName</span>
                            <strong style="color: @(awayWin ? "var(--green)" : "var(--text-primary)")">
                                @(pick.AwayScore?.ToString() ?? "—")
                            </strong>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                <span class="section-title d-block mb-2">Final · Jul 19</span>
                @foreach (var pick in Model.Picks.Where(p => p.Round == "FINAL"))
                {
                    var homeWin = pick.HomeScore.HasValue && pick.AwayScore.HasValue && pick.HomeScore > pick.AwayScore;
                    <div class="card gold-highlight text-center py-4">
                        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="var(--gold-bright)" stroke-width="1.5" class="mx-auto mb-2"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 01-10 0V4zM3 6h4v2a2 2 0 01-4 0V6zM17 6h4v2a2 2 0 01-4 0V6z" /></svg>
                        <div class="text-gold fw-bold text-mono" style="font-size:13px;letter-spacing:0.08em;">WORLD CHAMPION</div>
                        <div class="text-tertiary mt-3" style="color: @(homeWin ? "var(--green)" : "var(--text-primary)")">
                            @(pick.HomeScore.HasValue ? $"{pick.HomeTeamName} {pick.HomeScore} - {pick.AwayScore} {pick.AwayTeamName}" : "TBD")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex flex-column gap-4">
        <div class="panel">
            <div class="section-header">
                <h3 style="font-size:20px;">@Model.LeagueName</h3>
                <span class="badge" style="background:var(--bg-pill);color:var(--blue);border-color:rgba(77,163,255,0.3);">Private League</span>
            </div>
            <div class="d-flex flex-column gap-3">
                @foreach (var member in Model.LeagueStandings)
                {
                    <div class="d-flex align-items-center gap-3 @(member.Rank == 1 ? "gold-highlight p-2" : "")" style="@(member.Rank == 1 ? "border-radius:12px;" : "")">
                        <span class="text-tertiary text-mono" style="font-size:13px;width:24px;">#@member.Rank</span>
                        <div class="avatar"></div>
                        <div class="flex-grow-1">
                            <div class="fw-bold">@member.UserName</div>
                        </div>
                        <strong class="@(member.Rank == 1 ? "text-gold" : "")">@member.Points pts</strong>
                    </div>
                }
                <button class="btn btn-ghost" style="border-style:dashed;" data-action="invite-friend">+ Invite Friend</button>
            </div>
        </div>

        <div class="panel">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="dot live"></span>
                <h3 style="font-size:18px;color:var(--red);">Live Updates</h3>
            </div>
            <div class="d-flex flex-column gap-3" id="liveUpdatesFeed">
                @foreach (var evt in Model.LiveEvents.Take(5))
                {
                    <div class="d-flex gap-3">
                        <span class="text-mono text-secondary" style="font-size:13px;width:32px;">@evt.Minute'</span>
                        <div>
                            <div>@evt.Icon <strong>@evt.EventType — @evt.PlayerName</strong></div>
                            <div class="text-secondary" style="font-size:13px;">@evt.Score</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>