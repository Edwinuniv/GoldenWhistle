@model GoldenWhistle.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    ViewData["Page"] = "profile";
}

<div class="page-header">
    <div>
        <h1>My Profile</h1>
        <p class="subtitle">View your public profile and stats</p>
    </div>
</div>

<div class="profile-container">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="panel">
                <div class="text-center">
                    <div class="profile-avatar-large">@Model.DisplayName?.Substring(0, 1).ToUpper() ?? "U"</div>
                    <h3 class="mt-3">@Model.DisplayName</h3>
                    <p class="text-secondary">@Model.Email</p>
                    <p class="text-secondary" style="font-size:13px;">Member since @Model.CreatedAt.ToString("MMM yyyy")</p>
                    <div class="d-flex justify-content-center gap-2 mt-2">
                        <span class="badge badge-success">⚡ @Model.TotalPoints pts</span>
                        <span class="badge badge-gold">🏆 Top 10%</span>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-secondary">Country</span>
                        <span>@(Model.Country ?? "Not set")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-secondary">Predictions</span>
                        <span id="profilePredictions">Loading...</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-secondary">Accuracy</span>
                        <span id="profileAccuracy">Loading...</span>
                    </div>
                </div>
                <a href="/Profile/Settings" class="btn btn-outline w-100 mt-4">Edit Profile</a>
            </div>
        </div>

        <div class="col-md-8">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">🏆</div>
                        <div class="stat-value" id="profileRank">#--</div>
                        <div class="stat-label">Global Rank</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">🎯</div>
                        <div class="stat-value" id="profileCorrect">--</div>
                        <div class="stat-label">Correct Predictions</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">📊</div>
                        <div class="stat-value" id="profileTotalPicks">--</div>
                        <div class="stat-label">Total Picks</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">⭐</div>
                        <div class="stat-value" id="profileAccuracyValue">--%</div>
                        <div class="stat-label">Accuracy</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>