@{
    ViewData["Title"] = "Create Account";
    ViewData["Page"] = "home";
}

<div class="auth-page">
    <div class="auth-card">
        <a href="/" class="d-flex align-items-center gap-2 mb-5 text-decoration-none">
            <div class="app-logo-icon"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 11-13h-7z" /></svg></div>
            <span style="font-weight:800;font-size:18px;color:var(--text-primary);">WorldCupHub</span>
        </a>
        <h1 style="font-size:28px;margin-bottom:6px;">Create your account</h1>
        <p class="text-secondary mb-4">Join 250,000+ fans worldwide</p>

        <a href="/Account/ExternalLogin?provider=Google" class="btn-social-full mb-4">
            <svg viewBox="0 0 24 24" width="20" height="20"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" /><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" /></svg>
            Continue with Google
        </a>

        <div class="auth-divider"><span>or</span></div>

        <form asp-controller="Account" asp-action="Register" method="post" class="d-flex flex-column gap-3">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label-wch">First Name</label>
                    <input class="form-input-wch" type="text" name="firstName" placeholder="Marcus" required />
                </div>
                <div class="col-6">
                    <label class="form-label-wch">Last Name</label>
                    <input class="form-input-wch" type="text" name="lastName" placeholder="Thiel" required />
                </div>
            </div>
            <div>
                <label class="form-label-wch">Email</label>
                <input class="form-input-wch" type="email" name="email" placeholder="you@email.com" required />
            </div>
            <div>
                <label class="form-label-wch">Password</label>
                <input class="form-input-wch" type="password" name="password" placeholder="Min. 8 characters" required />
            </div>
            <div>
                <label class="form-label-wch">Favourite Team</label>
                <input class="form-input-wch" type="text" name="favouriteTeam" placeholder="e.g. Brazil, France..." />
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-2">Create Account</button>
        </form>

        <p class="text-center text-secondary mt-4" style="font-size:13px;">
            By signing up you agree to our <a href="#" style="color:var(--green);">Terms</a> and <a href="#" style="color:var(--green);">Privacy Policy</a>
        </p>
        <p class="text-center text-secondary mt-2" style="font-size:14px;">
            Already have an account? <a href="/Account/Login" style="color:var(--green);">Log in</a>
        </p>
    </div>
</div>
