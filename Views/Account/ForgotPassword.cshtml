@{
    ViewData["Title"] = "Forgot Password";
    ViewData["Page"] = "home";
}

<div class="auth-page">
    <div class="auth-card">
        <a href="/" class="d-flex align-items-center gap-2 mb-5 text-decoration-none">
            <div class="app-logo-icon"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 11-13h-7z" /></svg></div>
            <span style="font-weight:800;font-size:18px;color:var(--text-primary);">GoldenWhistle</span>
        </a>
        <h1 style="font-size:28px;margin-bottom:6px;">Reset your password</h1>
        <p class="text-secondary mb-4">Enter your email and we'll send you a reset link.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="d-flex flex-column gap-3">
            @Html.AntiForgeryToken()
            <div>
                <label class="form-label-wch">Email</label>
                <input class="form-input-wch" type="email" name="email" placeholder="you@email.com" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-2">Send Reset Link</button>
        </form>

        <p class="text-center text-secondary mt-4" style="font-size:14px;">
            <a href="/Account/Login" style="color:var(--green);">Back to log in</a>
        </p>
    </div>
</div>
