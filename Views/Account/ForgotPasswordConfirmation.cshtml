@{
    ViewData["Title"] = "Check your email";
    ViewData["Page"] = "home";
}

<div class="auth-page">
    <div class="auth-card text-center">
        <a href="/" class="d-flex align-items-center gap-2 mb-5 text-decoration-none justify-content-center">
            <div class="app-logo-icon"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 11-13h-7z" /></svg></div>
            <span style="font-weight:800;font-size:18px;color:var(--text-primary);">GoldenWhistle</span>
        </a>
        <h1 style="font-size:24px;margin-bottom:12px;">Check your email</h1>
        <p class="text-secondary">@ViewData["Message"]</p>
        <a href="/Account/Login" class="btn btn-primary w-100 mt-4">Back to log in</a>
    </div>
</div>
