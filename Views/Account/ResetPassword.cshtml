@model GoldenWhistle.Controllers.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["Page"] = "home";
}

<div class="auth-page">
    <div class="auth-card">
        <h1 style="font-size:28px;margin-bottom:6px;">Choose a new password</h1>
        <p class="text-secondary mb-4">Enter a new password for your account.</p>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="d-flex flex-column gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <div>
                <label class="form-label-wch">New password</label>
                <input class="form-input-wch" type="password" asp-for="NewPassword" placeholder="Min. 8 characters" required />
            </div>
            <div asp-validation-summary="All" class="text-danger" style="font-size:13px;"></div>
            <button type="submit" class="btn btn-primary w-100 mt-2">Reset Password</button>
        </form>
    </div>
</div>
