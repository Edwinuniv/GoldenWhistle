@* ===================================================================
   _Layout.cshtml — WorldCupHub shared shell
   Sidebar nav + Fan Pulse bar + main content slot
   =================================================================== *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — WorldCupHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">

        @* ============== SIDEBAR ============== *@
        <aside class="sidebar">
            <div class="sidebar-logo">
                <svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 11-13h-7l0-7z" /></svg>
            </div>

            <nav class="sidebar-nav">
                @{
                    var current = ViewContext.RouteData.Values["controller"]?.ToString();
                }
                <a class="nav-item @(current == "Home" ? "active" : "")" href="/">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Dashboard
                </a>
                <a class="nav-item @(current == "Bracket" ? "active" : "")" href="/Bracket">
                    <svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 01-10 0V4zM3 6h4v2a2 2 0 01-4 0V6zM17 6h4v2a2 2 0 01-4 0V6z" /></svg>
                    Bracket
                </a>
                <a class="nav-item @(current == "Mood" ? "active" : "")" href="/Mood">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" /></svg>
                    Mood
                </a>
                <a class="nav-item @(current == "Pub" ? "active" : "")" href="/Pub">
                    <svg viewBox="0 0 24 24"><path d="M12 21s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
                    Pub
                </a>
                <a class="nav-item @(current == "Data" ? "active" : "")" href="/Data">
                    <svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
                    Data
                </a>
                <a class="nav-item @(current == "Marketplace" ? "active" : "")" href="/Marketplace">
                    <svg viewBox="0 0 24 24"><path d="M3 7h18l-1.5 12.5a2 2 0 01-2 1.5H6.5a2 2 0 01-2-1.5L3 7zM8 7V5a4 4 0 018 0v2" /></svg>
                    Marketplace
                </a>
                <a class="nav-item @(current == "Simulator" ? "active" : "")" href="/Simulator">
                    <svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 11-13h-7l0-7z" /></svg>
                    What If
                </a>
            </nav>
        </aside>

        @* ============== MAIN ============== *@
        <div class="main-content">

            @* ---- Fan Pulse live bar (SignalR will update these values) ---- *@
            <div class="fan-pulse-bar" id="fanPulseBar"
                 data-ecstasy="48" data-anxious="31" data-agony="21" data-votes="247831">
                <span class="fan-pulse-label">FAN PULSE</span>
                <div class="fan-pulse-track">
                    <div class="fan-pulse-seg ecstasy" id="segEcstasy" style="width:48%"></div>
                    <div class="fan-pulse-seg anxious" id="segAnxious" style="width:31%"></div>
                    <div class="fan-pulse-seg agony" id="segAgony" style="width:21%"></div>
                </div>
                <span class="fan-pulse-stat"><span class="dot ecstasy"></span>Ecstasy <span class="value ecstasy" id="pctEcstasy">48%</span></span>
                <span class="fan-pulse-stat"><span class="dot anxious"></span>Anxious <span class="value anxious" id="pctAnxious">31%</span></span>
                <span class="fan-pulse-stat"><span class="dot agony"></span>Agony <span class="value agony" id="pctAgony">21%</span></span>
                <span class="live-tag"><span class="dot live"></span>LIVE <span id="voteCount">247,831</span> votes</span>
            </div>

            @* ---- Page content ---- *@
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
