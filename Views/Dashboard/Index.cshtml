@model GoldenWhistle.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Page"] = "dashboard";
}

<div class="page-header">
    <div>
        <h1>Good evening, <span style="color:var(--green)">@Model.UserDisplayName</span> 👋</h1>
        <p class="subtitle">FIFA World Cup 2026 · Quarterfinal Stage</p>
    </div>
    <div class="search-input">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        <input type="text" placeholder="Search teams, players..." />
    </div>
</div>

@* ---------------- Today's Fixtures ---------------- *@
<div style="padding: 0 var(--space-6);">
    <div class="section-header">
        <span class="section-title">Today's Fixtures</span>
        <a href="#" class="btn btn-outline" style="padding:8px 18px;font-size:13px;">View all</a>
    </div>
    <div class="row g-3">
        @foreach (var f in Model.Fixtures)
        {
            <div class="col-6 col-md-3">
                <div class="card @(f.IsLive ? "is-live" : "")">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge @(f.StatusBadge == "LIVE" ? "badge-live" : f.StatusBadge == "UPCOMING" ? "badge-upcoming" : "badge-ft")">
                            @if (f.IsLive)
                            {
                                <span class="dot live"></span>
                            }
                            @f.StatusBadge
                        </span>
                        <span class="text-tertiary text-mono" style="font-size:12px;">@f.MatchDate</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">@f.HomeTeamCode</span>
                        @if (f.IsLive || f.StatusBadge == "FT")
                        {
                            <span class="fw-bold fs-4" style="color:@(f.IsLive ? "var(--red)" : "inherit")">@f.HomeScore–@f.AwayScore</span>
                        }
                        else
                        {
                            <span class="fw-bold fs-4" style="color:var(--amber)">@f.KickoffTime</span>
                        }
                        <span class="fw-bold fs-5">@f.AwayTeamCode</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary text-mono" style="font-size:11px;">
                        <span>@f.HomeTeamName</span><span>vs</span><span>@f.AwayTeamName</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* ---------------- Live Bracket + Global Leaderboard ---------------- *@
<div class="content-grid">
    <div class="panel">
        <div class="section-header">
            <div>
                <h3 style="font-size:22px;">Live Bracket</h3>
                <p class="text-secondary" style="font-size:14px;margin-top:4px;">Quarterfinals · Round of 8</p>
            </div>
            <span class="badge badge-live"><span class="dot live"></span>LIVE</span>
        </div>
        <div class="row">
            @foreach (var round in new[] { "QF", "SF", "FINAL" })
            {
                <div class="col-md-4">
                    <span class="section-title d-block mb-2">
                        @(round == "QF" ? "Quarter-finals" : round == "SF" ? "Semi-finals" : "Final")
                    </span>
                    @foreach (var m in Model.BracketMatches.Where(x => x.Round == round))
                    {
                        <div class="card @(m.IsWinner ? "is-active" : "") mb-2">
                            <div class="d-flex justify-content-between">
                                <span>
                                    <span class="text-tertiary me-2" style="font-size:11px;">@m.HomeTeamCode</span>
                                    @m.HomeTeamName
                                </span>
                                <strong @(m.IsWinner ? "style=color:var(--green)" : "")>
                                    @(m.HomeScore?.ToString() ?? "—")
                                </strong>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span>
                                    <span class="text-tertiary me-2" style="font-size:11px;">@m.AwayTeamCode</span>
                                    @m.AwayTeamName
                                </span>
                                <strong>@(m.AwayScore?.ToString() ?? "—")</strong>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="section-header">
            <h3 style="font-size:22px;">Global Leaderboard</h3>
        </div>
        <p class="text-secondary" style="font-size:14px;margin-top:-8px;margin-bottom:16px;">This week's top predictors</p>
        <div class="d-flex flex-column gap-3" id="leaderboardList">
            @foreach (var l in Model.TopLeaders)
            {
                <div class="d-flex align-items-center gap-3 @(l.Rank == 1 ? "gold-highlight p-2" : "")"
                     style="@(l.Rank == 1 ? "border-radius:12px;" : "")">
                    <span class="rank-badge @(l.Rank == 1 ? "gold" : "")">@l.Rank</span>
                    <div class="avatar"></div>
                    <div class="flex-grow-1">
                        <div class="fw-bold">@l.UserName</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold @(l.Rank == 1 ? "text-gold" : "")">@l.Points.ToString("N0")</div>
                        <div class="stat-delta" style="color:var(--green)">+@l.PointsDelta</div>
                    </div>
                </div>
            }
        </div>
        <a href="/Bracket" class="btn btn-primary w-100 mt-4">Full Leaderboard</a>
    </div>
</div>

@* ---------------- Stat Tiles ---------------- *@
<div class="stat-grid mb-4">
    <div class="stat-tile">
        <div class="stat-icon" style="background:var(--green-bg);">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M12 15a4 4 0 100-8 4 4 0 000 8zM6 21l1.5-5M18 21l-1.5-5" /></svg>
        </div>
        <div>
            <div class="stat-label">Your Points</div>
            <div class="stat-value" style="color:var(--green)">@Model.UserTotalPoints.ToString("N0")</div>
            <div class="stat-delta">+@Model.UserPointsDeltaToday today</div>
        </div>
    </div>
    <div class="stat-tile">
        <div class="stat-icon" style="background:rgba(77,163,255,0.12);">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /></svg>
        </div>
        <div>
            <div class="stat-label">Predictions Made</div>
            <div class="stat-value" style="color:var(--blue)">@Model.UserPredictionsMade</div>
            <div class="stat-delta">@Model.UserAccuracyPct% accuracy</div>
        </div>
    </div>
    <div class="stat-tile gold-highlight">
        <div class="stat-icon" style="background:var(--amber-bg-strong);">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--gold-bright)" stroke-width="2"><path d="M3 17l6-6 4 4 8-8" /></svg>
        </div>
        <div>
            <div class="stat-label">Bracket Rank</div>
            <div class="stat-value text-gold">#@Model.UserBracketRank</div>
            <div class="stat-delta">of @Model.TotalPlayers.ToString("N0")</div>
        </div>
    </div>
    <div class="stat-tile">
        <div class="stat-icon" style="background:var(--red-bg);">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2"><path d="M12 2a7 7 0 017 7c0 5-7 13-7 13S5 14 5 9a7 7 0 017-7z" /></svg>
        </div>
        <div>
            <div class="stat-label">Live Now</div>
            <div class="stat-value" style="color:var(--red)">
                @Model.Fixtures.Count(f => f.IsLive) match@(Model.Fixtures.Count(f => f.IsLive) > 1 ? "es" : "")
            </div>
            <div class="stat-delta">
                @(Model.Fixtures.FirstOrDefault(f => f.IsLive) is { } live
                    ? $"{live.HomeTeamCode} vs {live.AwayTeamCode}"
                    : "No live match")
            </div>
        </div>
    </div>
</div>

@* ---------------- xG by Match chart ---------------- *@
<div style="padding: 0 var(--space-6) var(--space-8);">
    <div class="panel">
        <h3 style="font-size:22px;">xG by Match</h3>
        <p class="text-secondary" style="font-size:14px;margin-top:4px;margin-bottom:20px;">
            Expected goals vs actual — this round
        </p>
        <div class="chart-wrap" style="height:280px;">
            <canvas id="xgByMatchChart"
                    data-labels="@string.Join(",", Model.XgByMatch.Select(x => x.MatchLabel))"
                    data-values="@string.Join(",", Model.XgByMatch.Select(x => x.XgValue))">
            </canvas>
        </div>
    </div>
</div>
