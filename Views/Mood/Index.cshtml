@model GoldenWhistle.ViewModels.MoodViewModel
@{
    ViewData["Title"] = "Fan Mood Map";
    ViewData["Page"] = "mood";
}

<div class="page-header">
    <div>
        <h1>Fan Mood Map</h1>
        <p class="subtitle">Real-time emotional pulse of the global football community</p>
    </div>
</div>

<div class="mood-page-content">
    <!-- Match Selector -->
    <div class="mood-match-selector">
        <select id="matchSelector" class="form-control" onchange="loadMatch(this.value)">
            <option value="">-- Select a match --</option>
        </select>
    </div>

    <div class="panel mb-4">
        <div class="row g-4 align-items-center">
            <!-- Left: Doughnut + Legend -->
            <div class="col-md-5">
                <div class="doughnut-wrap">
                    <canvas id="moodDoughnut"
                            data-ecstasy="@Model.EcstasyPct"
                            data-anxiety="@Model.AnxietyPct"
                            data-agony="@Model.AgonyPct">
                    </canvas>
                    <div id="doughnutCenter" class="doughnut-center">
                        <div class="doughnut-emoji">🌍</div>
                        <div class="doughnut-label">Global mood</div>
                    </div>
                </div>
                <div class="d-flex flex-column gap-1 mt-3">
                    <div class="mood-legend-row">
                        <span class="d-flex align-items-center gap-2"><span class="dot ecstasy"></span>Ecstasy</span>
                        <div class="mood-legend-bar-wrap">
                            <strong class="mood-legend-pct" style="color:var(--green);" id="legendPctE">@Model.EcstasyPct%</strong>
                            <div class="mood-bar-track"><div id="barE" class="mood-bar-fill" style="width:@Model.EcstasyPct%;background:var(--green);"></div></div>
                        </div>
                    </div>
                    <div class="mood-legend-row">
                        <span class="d-flex align-items-center gap-2"><span class="dot anxious"></span>Anxious</span>
                        <div class="mood-legend-bar-wrap">
                            <strong class="mood-legend-pct" style="color:var(--amber);" id="legendPctA">@Model.AnxietyPct%</strong>
                            <div class="mood-bar-track"><div id="barA" class="mood-bar-fill" style="width:@Model.AnxietyPct%;background:var(--amber);"></div></div>
                        </div>
                    </div>
                    <div class="mood-legend-row">
                        <span class="d-flex align-items-center gap-2"><span class="dot agony"></span>Agony</span>
                        <div class="mood-legend-bar-wrap">
                            <strong class="mood-legend-pct" style="color:var(--red);" id="legendPctG">@Model.AgonyPct%</strong>
                            <div class="mood-bar-track"><div id="barG" class="mood-bar-fill" style="width:@Model.AgonyPct%;background:var(--red);"></div></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Voting -->
            <div class="col-md-7">
                <h2 class="mood-question">How do you feel right now?</h2>
                <p class="mood-match-info" id="moodMatchInfo">
                    Watching <span id="matchHomeTeam">@Model.HomeTeamName</span> vs <span id="matchAwayTeam">@Model.AwayTeamName</span>
                    · <span id="matchStatus">@Model.MatchMinuteLabel</span>
                    · <span id="matchScore">@Model.ScoreLabel</span>
                </p>

                <div class="live-voting-header">
                    <span class="live-voting-badge"><span class="dot live"></span> LIVE VOTING</span>
                    <span class="live-voting-count" id="voteCountPanel">@Model.TotalVotes.ToString("N0") fans voted</span>
                </div>

                <div class="d-flex flex-column gap-2" id="votingBtns">
                    <button class="emotion-btn @(Model.CurrentUserVote == "Ecstasy" ? "selected-ecstasy" : "")"
                            data-emotion="ecstasy" onclick="castVote('ecstasy')">
                        <span class="emotion-emoji">🤩</span>
                        <div>
                            <div class="emotion-name" style="color:var(--green);">Ecstasy</div>
                            <div class="emotion-sub">We're absolutely loving it!</div>
                        </div>
                        <div class="emotion-pct">
                            <div class="pct-value" style="color:var(--green);" id="pctE">@Model.EcstasyPct%</div>
                            <div class="pct-fans" id="fansE">@Model.EcstasyCount.ToString("N0") fans</div>
                        </div>
                        <span class="emotion-checkmark">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#052" stroke-width="3"><path d="M5 13l4 4L19 7" /></svg>
                        </span>
                    </button>

                    <button class="emotion-btn @(Model.CurrentUserVote == "Anxiety" ? "selected-anxious" : "")"
                            data-emotion="anxious" onclick="castVote('anxious')">
                        <span class="emotion-emoji">😬</span>
                        <div>
                            <div class="emotion-name text-gold">Anxious</div>
                            <div class="emotion-sub">On the edge of my seat...</div>
                        </div>
                        <div class="emotion-pct">
                            <div class="pct-value text-gold" id="pctA">@Model.AnxietyPct%</div>
                            <div class="pct-fans" id="fansA">@Model.AnxietyCount.ToString("N0") fans</div>
                        </div>
                        <span class="emotion-checkmark emotion-checkmark-amber">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#1a0" stroke-width="3"><path d="M5 13l4 4L19 7" /></svg>
                        </span>
                    </button>

                    <button class="emotion-btn @(Model.CurrentUserVote == "Agony" ? "selected-agony" : "")"
                            data-emotion="agony" onclick="castVote('agony')">
                        <span class="emotion-emoji">😭</span>
                        <div>
                            <div class="emotion-name" style="color:var(--red);">Agony</div>
                            <div class="emotion-sub">This is painful to watch</div>
                        </div>
                        <div class="emotion-pct">
                            <div class="pct-value" style="color:var(--red);" id="pctG">@Model.AgonyPct%</div>
                            <div class="pct-fans" id="fansG">@Model.AgonyCount.ToString("N0") fans</div>
                        </div>
                        <span class="emotion-checkmark emotion-checkmark-red">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3"><path d="M5 13l4 4L19 7" /></svg>
                        </span>
                    </button>
                </div>

                <div class="thanks-msg @(Model.CurrentUserVote != null ? "visible" : "")" id="thanksMsg">
                    Your vote is in! <span>Thanks for sharing your pulse 💚</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline -->
    <div class="panel">
        <h3 style="font-size:20px;">Mood Timeline</h3>
        <p class="text-secondary" style="font-size:13px;margin-top:2px;margin-bottom:16px;">Fan sentiment over the last 90 minutes</p>
        <div class="chart-wrap" style="height:240px;">
            <canvas id="moodTimelineChart"
                    data-labels="@string.Join(",", Model.Timeline.Select(t => t.Minute))"
                    data-ecstasy="@string.Join(",", Model.Timeline.Select(t => t.EcstasyCount))"
                    data-anxiety="@string.Join(",", Model.Timeline.Select(t => t.AnxietyCount))"
                    data-agony="@string.Join(",", Model.Timeline.Select(t => t.AgonyCount))">
            </canvas>
        </div>
    </div>
</div>

<input type="hidden" id="currentMatchId" value="@Model.MatchId" />
<input type="hidden" id="currentUserVote" value="@Model.CurrentUserVote" />